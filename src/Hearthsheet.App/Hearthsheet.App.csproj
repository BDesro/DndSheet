<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Hearthsheet</AssemblyName>
    <RootNamespace>Hearthsheet.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Original artwork (red d20 on black), not a Wizards of the Coast trademark; see NOTICE.md. -->
    <ApplicationIcon>Assets\Hearthsheet.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hearthsheet.Core\Hearthsheet.Core.csproj" />
    <ProjectReference Include="..\Hearthsheet.Infrastructure\Hearthsheet.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
