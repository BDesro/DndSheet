<Window x:Class="Hearthsheet.App.Views.QuickAddDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NameBox}">
    <StackPanel Margin="22,18" Width="380">
        <TextBlock x:Name="Heading" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
        <HeaderedContentControl Header="Name" Style="{StaticResource Field}" Margin="0,0,0,12">
            <TextBox x:Name="NameBox" AutomationProperties.Name="Name" />
        </HeaderedContentControl>
        <HeaderedContentControl x:Name="KindField" Header="Type" Style="{StaticResource Field}" Margin="0,0,0,12">
            <ComboBox x:Name="KindBox" AutomationProperties.Name="Type">
                <ComboBox.ItemTemplate>
                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" /></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </HeaderedContentControl>
        <HeaderedContentControl x:Name="DescriptionField" Header="Description (optional)" Style="{StaticResource Field}" Margin="0,0,0,12">
            <TextBox x:Name="DescriptionBox" Style="{StaticResource MultilineBox}" AutomationProperties.Name="Description" />
        </HeaderedContentControl>
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" Margin="0,0,0,8" Visibility="Collapsed" Text="Enter a name." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Add" IsDefault="True" Style="{StaticResource AccentButton}" Click="OnAdd" />
        </StackPanel>
    </StackPanel>
</Window>
