<Window x:Class="Hearthsheet.App.Views.ShortRestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Short rest" Style="{StaticResource AppWindow}" SizeToContent="WidthAndHeight"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=RollBox}">
    <StackPanel Margin="22,18" Width="400">
        <TextBlock Style="{StaticResource SectionTitle}" Text="Short rest" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="Spend hit dice to heal: each die heals its roll plus your Constitution modifier. Enter your physical roll, or let the app roll. Finishing the rest then recovers short-rest resources." />
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="HpText" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="DiceText" Foreground="{StaticResource InkMuted}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Roll" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="RollBox" Width="56" HorizontalContentAlignment="Center" AutomationProperties.Name="Hit die roll" />
            <Button x:Name="SpendButton" Content="Spend hit die" Margin="8,0,0,0" Click="OnSpend" IsDefault="True" />
            <Button x:Name="RollButton" Content="🎲 Roll for me" Margin="8,0,0,0" Click="OnRoll" />
        </StackPanel>
        <TextBlock x:Name="Feedback" TextWrapping="Wrap" Margin="0,0,0,12" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" ToolTip="Hit dice already spent stay spent" />
            <Button Content="Finish short rest" Style="{StaticResource AccentButton}" Click="OnFinish" />
        </StackPanel>
    </StackPanel>
</Window>
