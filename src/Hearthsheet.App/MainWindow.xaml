<Window x:Class="Hearthsheet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Hearthsheet.App.Views"
        xmlns:app="clr-namespace:Hearthsheet.Core.Application;assembly=Hearthsheet.Core"
        Title="{Binding Current.Title, StringFormat={}{0} — Hearthsheet, FallbackValue=Hearthsheet, TargetNullValue=Hearthsheet}"
        Style="{StaticResource AppWindow}" Width="1360" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCharacter}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewCharacter}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ShowView}" CommandParameter="0" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding ShowView}" CommandParameter="1" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding ShowView}" CommandParameter="2" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomIn}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomIn}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOut}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOut}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding ZoomReset}" />
        <KeyBinding Key="P" Modifiers="Control" Command="ApplicationCommands.Print" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Print" Executed="OnPrint" CanExecute="CanPrint" />
    </Window.CommandBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{StaticResource Surface}" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="_New character…" Command="{Binding NewCharacter}" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Duplicate character" Command="{Binding DuplicateCharacter}" />
                <Separator />
                <MenuItem Header="_Import character…" Command="{Binding ImportCharacter}" />
                <MenuItem Header="_Export character…" Command="{Binding ExportCharacter}" />
                <Separator />
                <MenuItem Header="_Save" Command="{Binding SaveCharacter}" InputGestureText="Ctrl+S" />
                <MenuItem Header="_Print sheet…" Command="ApplicationCommands.Print" InputGestureText="Ctrl+P" />
                <Separator />
                <MenuItem Header="De_lete character…" Command="{Binding DeleteCharacter}" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Character _sheet" Command="{Binding ShowView}" CommandParameter="0" InputGestureText="Ctrl+1" />
                <MenuItem Header="_Details" Command="{Binding ShowView}" CommandParameter="1" InputGestureText="Ctrl+2" />
                <MenuItem Header="_Play" Command="{Binding ShowView}" CommandParameter="2" InputGestureText="Ctrl+3" />
                <Separator />
                <MenuItem Header="Zoom _in" Command="{Binding ZoomIn}" InputGestureText="Ctrl++" />
                <MenuItem Header="Zoom _out" Command="{Binding ZoomOut}" InputGestureText="Ctrl+−" />
                <MenuItem Header="_Reset zoom" Command="{Binding ZoomReset}" InputGestureText="Ctrl+0" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Check for _updates…" Command="{Binding Update.ShowDialog}" />
                <MenuItem Header="GitHub _token (private releases)…" Command="{Binding ManageToken}" />
                <Separator />
                <MenuItem Header="Open _log folder" Command="{Binding OpenLogs}" />
                <MenuItem Header="Open _data folder" Command="{Binding OpenDataFolder}" />
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="12,4">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center">
                    <Run Text="Hearthsheet" /> <Run Text="{Binding AppVersion, Mode=OneWay}" />
                </TextBlock>
                <TextBlock DockPanel.Dock="Right" Text="Development mode · " Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                           Visibility="{Binding IsDevelopmentMode, Converter={StaticResource VisibleWhen}}" />
                <Button DockPanel.Dock="Right" Margin="0,0,14,0" Padding="10,1" MinHeight="22" Command="{Binding Update.ShowDialog}"
                        Visibility="{Binding Update.IsUpdateAvailable, Converter={StaticResource VisibleWhen}}"
                        Content="{Binding Update.Available.Version}" ContentStringFormat="Update {0} available" />
                <TextBlock Text="{Binding SaveStatus}" Foreground="{StaticResource InkMuted}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Character list -->
            <DockPanel Background="{StaticResource Sidebar}">
                <StackPanel DockPanel.Dock="Top" Margin="14,14,14,8">
                    <TextBlock Text="Characters" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <UniformGrid Columns="2">
                        <Button Content="+ New" Style="{StaticResource AccentButton}" Command="{Binding NewCharacter}" Margin="0,0,4,0" />
                        <Button Content="Import…" Command="{Binding ImportCharacter}" Margin="4,0,0,0" />
                    </UniformGrid>
                </StackPanel>
                <UniformGrid DockPanel.Dock="Bottom" Columns="3" Margin="14,6,14,12">
                    <Button Content="Duplicate" Command="{Binding DuplicateCharacter}" Margin="0,0,4,0" Padding="4,5" />
                    <Button Content="Export…" Command="{Binding ExportCharacter}" Margin="2,0" Padding="4,5" />
                    <Button Content="Delete" Command="{Binding DeleteCharacter}" Foreground="{StaticResource Danger}" Margin="4,0,0,0" Padding="4,5" />
                </UniformGrid>
                <Grid>
                    <ListBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedSummary}" Background="Transparent" BorderThickness="0"
                             Padding="8,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Characters">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="Padding" Value="10,7" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E2DCD1" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type app:CharacterSummary}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{StaticResource InkMuted}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Margin="16,8" TextWrapping="Wrap" Foreground="{StaticResource InkMuted}"
                               Text="No characters yet. Create one or import a .dndchar file."
                               Visibility="{Binding Characters.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}" />
                </Grid>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{StaticResource Line}"
                          ResizeBehavior="PreviousAndNext" Focusable="False" />

            <!-- Empty state -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                        Visibility="{Binding HasCharacter, Converter={StaticResource VisibleWhen}, ConverterParameter=Invert}">
                <TextBlock Text="No character open" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Style="{StaticResource Hint}" TextAlignment="Center" Margin="0,8,0,18"
                           Text="Create a new character to fill in the sheet, or import one exported from Hearthsheet." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Create character" Style="{StaticResource AccentButton}" Command="{Binding NewCharacter}" Margin="0,0,8,0" Padding="16,7" />
                    <Button Content="Import…" Command="{Binding ImportCharacter}" Padding="16,7" />
                </StackPanel>
            </StackPanel>

            <!-- One character, three views -->
            <TabControl Grid.Column="2" SelectedIndex="{Binding SelectedView}" BorderThickness="0" Padding="0" Background="{StaticResource Canvas}"
                        Visibility="{Binding HasCharacter, Converter={StaticResource VisibleWhen}}">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource ViewTab}" />
                </TabControl.Resources>
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
                                <DockPanel Margin="16,0">
                                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Current.Title}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Current.Summary}" Foreground="{StaticResource InkMuted}" HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                                </DockPanel>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </DockPanel>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="Character Sheet">
                    <views:SheetView x:Name="Sheet" DataContext="{Binding Current}" />
                </TabItem>
                <TabItem Header="Details">
                    <views:DetailsView DataContext="{Binding Current}" />
                </TabItem>
                <TabItem Header="Play">
                    <views:PlayView DataContext="{Binding Current}" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
