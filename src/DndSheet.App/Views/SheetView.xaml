<UserControl x:Class="DndSheet.App.Views.SheetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DndSheet.App.ViewModels"
             xmlns:mvvm="clr-namespace:DndSheet.App.Mvvm"
             xmlns:domain="clr-namespace:DndSheet.Core.Domain;assembly=DndSheet.Core"
             PreviewMouseWheel="OnPreviewMouseWheel">
    <!-- The traditional 5e sheet as three letter-size pages. Structured WPF layout (not a PDF overlay):
         every value is a live binding to the shared character model, zoom is vector-crisp, and the same
         visuals are sent to the printer. -->
    <UserControl.Resources>
        <Style x:Key="SheetField" TargetType="HeaderedContentControl">
            <Setter Property="Margin" Value="5,2" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="HeaderedContentControl">
                        <StackPanel VerticalAlignment="Bottom">
                            <ContentPresenter />
                            <Border Height="1" Background="{StaticResource SheetLine}" />
                            <TextBlock Style="{StaticResource SheetLabelLeft}" Text="{TemplateBinding Header}" Margin="0,1,0,0" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Skill bubble cycles None → Proficient → Expertise (half proficiency is set in Details). -->
        <Style x:Key="SkillDot" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="ToolTip" Value="Click to cycle: not proficient → proficient → expertise" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="12" Height="12" Background="Transparent">
                            <Ellipse Stroke="{StaticResource SheetLine}" StrokeThickness="1.2" />
                            <Ellipse x:Name="Fill" Margin="2.5" Fill="{StaticResource SheetInk}" Visibility="Collapsed" />
                            <Ellipse x:Name="Half" Margin="3.5" Fill="{StaticResource SheetFaint}" Visibility="Collapsed" />
                            <Ellipse x:Name="Ring" Margin="-2.5" Stroke="{StaticResource SheetLine}" StrokeThickness="1" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Model.Proficiency}" Value="Half">
                                <Setter TargetName="Half" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Model.Proficiency}" Value="Proficient">
                                <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Model.Proficiency}" Value="Expertise">
                                <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SpellLevelBlock" DataType="{x:Type vm:SpellLevelRow}">
            <Border Style="{StaticResource SheetBox}" Margin="3,3,3,6">
                <StackPanel>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SheetInk}" CornerRadius="4" Padding="2">
                            <TextBlock Text="{Binding Level}" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Margin="10,0,0,0"
                                        Visibility="{Binding Slot, Converter={StaticResource VisibleWhen}}">
                                <TextBlock Text="Slots" FontSize="9" Foreground="{StaticResource SheetFaint}" VerticalAlignment="Center" Margin="0,0,3,0" />
                                <TextBox Style="{StaticResource SheetNumber}" Width="26" FontSize="11" Text="{Binding Slot.Maximum}"
                                         AutomationProperties.Name="Slots total" />
                                <TextBlock Text="used" FontSize="9" Foreground="{StaticResource SheetFaint}" VerticalAlignment="Center" Margin="4,0,3,0" />
                                <TextBox Style="{StaticResource SheetNumber}" Width="26" FontSize="11" Text="{Binding Slot.Expended}"
                                         AutomationProperties.Name="Slots expended" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource SheetAddButton}" ToolTip="Add spell"
                                Command="{Binding DataContext.AddSpell, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding Level}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Spells}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type domain:Spell}">
                                <Grid Background="Transparent">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="18" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource SheetDot}" IsChecked="{Binding Prepared}" ToolTip="Prepared"
                                              AutomationProperties.Name="Prepared" />
                                    <TextBox Grid.Column="1" Style="{StaticResource SheetInput}" FontSize="11" Text="{Binding Name}"
                                             AutomationProperties.Name="Spell name" />
                                    <Button Grid.Column="2" Style="{StaticResource SheetRowButton}" Content="✕" ToolTip="Remove spell"
                                            Command="{Binding DataContext.RemoveEntry, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Sheet toolbar: section navigation, zoom, print. -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="−" Width="30" Padding="0" Command="{Binding DataContext.ZoomOut, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="Zoom out (Ctrl+−)" AutomationProperties.Name="Zoom out" />
                    <Button Width="62" Margin="4,0" Command="{Binding DataContext.ZoomReset, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="Reset zoom (Ctrl+0)" AutomationProperties.Name="Reset zoom"
                            Content="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=Window}}" ContentStringFormat="{}{0:P0}" />
                    <Button Content="+" Width="30" Padding="0" Command="{Binding DataContext.ZoomIn, RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="Zoom in (Ctrl++)" AutomationProperties.Name="Zoom in" />
                    <Button Content="🖶  Print…" Margin="12,0,0,0" Click="OnPrint" ToolTip="Print the sheet (Ctrl+P)" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Go to" VerticalAlignment="Center" Foreground="{StaticResource InkMuted}" Margin="0,0,8,0" />
                    <Button Content="Main" Tag="{Binding ElementName=Page1}" Click="OnGoToPage" Margin="0,0,4,0" />
                    <Button Content="Backstory" Tag="{Binding ElementName=Page2}" Click="OnGoToPage" Margin="0,0,4,0" />
                    <Button Content="Spells" Tag="{Binding ElementName=Page3}" Click="OnGoToPage" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#D9D4CB" Focusable="False">
            <StackPanel x:Name="Pages" HorizontalAlignment="Center" Margin="24">
                <StackPanel.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=Window}}"
                                    ScaleY="{Binding DataContext.Zoom, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel.LayoutTransform>

                <!-- ═════════════ PAGE 1 — MAIN ═════════════ -->
                <Border x:Name="Page1" Style="{StaticResource SheetPage}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SheetShadedBox}" VerticalAlignment="Center" Padding="10,8">
                                <StackPanel>
                                    <TextBox Style="{StaticResource SheetInput}" FontSize="20" FontWeight="SemiBold"
                                             Text="{Binding Character.Identity.Name}" AutomationProperties.Name="Character name" />
                                    <Border Height="1" Background="{StaticResource SheetLine}" />
                                    <TextBlock Style="{StaticResource SheetLabelLeft}" Text="Character Name" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SheetBox}">
                                <UniformGrid Columns="4" Rows="2">
                                    <HeaderedContentControl Header="Class" Style="{StaticResource SheetField}">
                                        <TextBox Style="{StaticResource SheetInput}" Text="{Binding Character.Identity.ClassName}" AutomationProperties.Name="Class" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Level" Style="{StaticResource SheetField}">
                                        <TextBox Style="{StaticResource SheetInput}" Text="{Binding Character.Identity.Level}" AutomationProperties.Name="Level" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Subclass" Style="{StaticResource SheetField}">
                                        <TextBox Style="{StaticResource SheetInput}" Text="{Binding Character.Identity.Subclass}" AutomationProperties.Name="Subclass" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Background" Style="{StaticResource SheetField}">
                                        <TextBox Style="{StaticResource SheetInput}" Text="{Binding Character.Identity.Background}" AutomationProperties.Name="Background" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Species" Style="{StaticResource SheetField}">
                                        <TextBox Style="{StaticResource SheetInput}" Text="{Binding Character.Identity.Species}" AutomationProperties.Name="Species" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Alignment" Style="{StaticResource SheetField}">
                                        <TextBox Style="{StaticResource SheetInput}" Text="{Binding Character.Identity.Alignment}" AutomationProperties.Name="Alignment" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Experience Points" Style="{StaticResource SheetField}">
                                        <TextBox Style="{StaticResource SheetInput}" Text="{Binding Character.Identity.Experience}" AutomationProperties.Name="Experience points" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Player Name" Style="{StaticResource SheetField}">
                                        <TextBox Style="{StaticResource SheetInput}" Text="{Binding Character.Identity.PlayerName}" AutomationProperties.Name="Player name" />
                                    </HeaderedContentControl>
                                </UniformGrid>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="248" />
                                <ColumnDefinition Width="264" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Column 1: abilities, inspiration, proficiency, saves, skills, passive perception, proficiencies -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Style="{StaticResource SheetShadedBox}" Padding="2">
                                    <ItemsControl ItemsSource="{Binding Abilities}" IsTabStop="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:AbilityRow}">
                                                <Border Style="{StaticResource SheetBox}" Margin="2,3" Padding="2,3,2,4">
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource SheetLabel}" Text="{Binding Name}" />
                                                        <TextBlock Style="{StaticResource SheetBig}" Text="{Binding Modifier, Converter={StaticResource Mod}}" />
                                                        <Border BorderBrush="{StaticResource SheetLine}" BorderThickness="1" CornerRadius="9" Width="42" HorizontalAlignment="Center">
                                                            <TextBox Style="{StaticResource SheetNumber}" FontSize="12" Text="{Binding Score}"
                                                                     AutomationProperties.Name="{Binding Name, StringFormat={}{0} score}" />
                                                        </Border>
                                                        <TextBlock HorizontalAlignment="Center" FontSize="8.5" Foreground="{StaticResource Accent}"
                                                                   Text="{Binding EffectiveScore, StringFormat=effective {0}}"
                                                                   Visibility="{Binding IsModifiedByEffects, Converter={StaticResource VisibleWhen}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <Border Style="{StaticResource SheetBox}" Padding="6,4">
                                        <DockPanel>
                                            <CheckBox Style="{StaticResource SheetDot}" IsChecked="{Binding Character.Identity.Inspiration}"
                                                      AutomationProperties.Name="Inspiration" Margin="0,0,8,0" />
                                            <TextBlock Style="{StaticResource SheetLabelLeft}" Text="Inspiration" VerticalAlignment="Center" FontSize="9.5" />
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource SheetBox}" Padding="6,4">
                                        <DockPanel>
                                            <TextBlock Text="{Binding ProficiencyBonus, Converter={StaticResource Mod}}" FontSize="16" FontWeight="SemiBold" Width="30" />
                                            <TextBlock Style="{StaticResource SheetLabelLeft}" Text="Proficiency Bonus" VerticalAlignment="Center" FontSize="9.5" />
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource SheetBox}">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Saves}" IsTabStop="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:SaveRow}">
                                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                                            <CheckBox Style="{StaticResource SheetDot}" IsChecked="{Binding Model.Proficient}"
                                                                      AutomationProperties.Name="{Binding Name, StringFormat={}{0} save proficiency}" />
                                                            <TextBlock Text="{Binding Modifier, Converter={StaticResource Mod}}" Width="26" TextAlignment="Center" FontSize="11" Margin="2,0" />
                                                            <TextBlock Text="{Binding Name}" FontSize="11" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Style="{StaticResource SheetLabel}" Text="Saving Throws" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource SheetBox}">
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding Skills}" IsTabStop="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:SkillRow}">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0.5">
                                                            <Button Style="{StaticResource SkillDot}"
                                                                    Command="{Binding DataContext.CycleSkillProficiency, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    AutomationProperties.Name="{Binding Name, StringFormat={}{0} proficiency}" />
                                                            <TextBlock Text="{Binding Modifier, Converter={StaticResource Mod}}" Width="26" TextAlignment="Center" FontSize="10.5" Margin="2,0" />
                                                            <TextBlock Text="{Binding Name}" FontSize="10.5" />
                                                            <TextBlock Text="{Binding AbilityAbbreviation, StringFormat=' ({0})'}" FontSize="9" Foreground="{StaticResource SheetFaint}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Style="{StaticResource SheetLabel}" Text="Skills" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource SheetBox}" Padding="6,4">
                                    <DockPanel>
                                        <TextBlock Text="{Binding PassivePerception}" FontSize="16" FontWeight="SemiBold" Width="34" />
                                        <TextBlock Style="{StaticResource SheetLabelLeft}" Text="Passive Wisdom (Perception)" VerticalAlignment="Center" FontSize="9.5" />
                                    </DockPanel>
                                </Border>

                                <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource SheetBox}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource SheetLabel}" Text="Other Proficiencies &amp; Languages" />
                                        <Button DockPanel.Dock="Top" Style="{StaticResource SheetAddButton}" ToolTip="Add proficiency or language"
                                                Command="{Binding AddProficiency}" CommandParameter="{x:Static domain:ProficiencyCategory.Language}" />
                                        <ItemsControl ItemsSource="{Binding Character.Proficiencies}" IsTabStop="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type domain:Proficiency}">
                                                    <Grid Background="Transparent">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="58" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="18" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Category}" FontSize="9" Foreground="{StaticResource SheetFaint}" VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1" Style="{StaticResource SheetInput}" FontSize="11" Text="{Binding Name}"
                                                                 AutomationProperties.Name="Proficiency" />
                                                        <Button Grid.Column="2" Style="{StaticResource SheetRowButton}" Content="✕" ToolTip="Remove"
                                                                Command="{Binding DataContext.RemoveEntry, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <!-- Column 2: AC/initiative/speed, HP, hit dice, death saves, attacks, equipment -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource SheetShadedBox}">
                                    <StackPanel>
                                        <UniformGrid Columns="3">
                                            <Border Style="{StaticResource SheetBox}" Padding="2,4">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource SheetBig}" Text="{Binding ArmorClass}" />
                                                    <TextBlock Style="{StaticResource SheetLabel}" Text="Armor Class" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="base" FontSize="8.5" Foreground="{StaticResource SheetFaint}" VerticalAlignment="Center" />
                                                        <TextBox Style="{StaticResource SheetNumber}" FontSize="10" Width="26" Text="{Binding Character.Combat.ArmorClass}"
                                                                 AutomationProperties.Name="Base armor class" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource SheetBox}" Padding="2,4">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource SheetBig}" Text="{Binding Initiative, Converter={StaticResource Mod}}" />
                                                    <TextBlock Style="{StaticResource SheetLabel}" Text="Initiative" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="bonus" FontSize="8.5" Foreground="{StaticResource SheetFaint}" VerticalAlignment="Center" />
                                                        <TextBox Style="{StaticResource SheetNumber}" FontSize="10" Width="26" Text="{Binding Character.Combat.InitiativeBonus}"
                                                                 AutomationProperties.Name="Initiative bonus" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource SheetBox}" Padding="2,4">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource SheetBig}" Text="{Binding Speed}" />
                                                    <TextBlock Style="{StaticResource SheetLabel}" Text="Speed" />
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="base" FontSize="8.5" Foreground="{StaticResource SheetFaint}" VerticalAlignment="Center" />
                                                        <TextBox Style="{StaticResource SheetNumber}" FontSize="10" Width="30" Text="{Binding Character.Combat.Speed}"
                                                                 AutomationProperties.Name="Base speed" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <Border Style="{StaticResource SheetBox}">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Hit Point Maximum" FontSize="9" Foreground="{StaticResource SheetFaint}" VerticalAlignment="Center" />
                                                    <TextBox Style="{StaticResource SheetNumber}" FontSize="11" Width="40" Text="{Binding Character.Combat.MaxHp}"
                                                             AutomationProperties.Name="Hit point maximum" />
                                                    <TextBlock FontSize="9" Foreground="{StaticResource Accent}" VerticalAlignment="Center"
                                                               Text="{Binding MaxHitPoints, StringFormat=(effective {0})}"
                                                               Visibility="{Binding MaxHpModified, Converter={StaticResource VisibleWhen}}" />
                                                </StackPanel>
                                                <TextBox Style="{StaticResource SheetNumber}" FontSize="26" FontWeight="SemiBold" Text="{Binding Character.Combat.CurrentHp}"
                                                         AutomationProperties.Name="Current hit points" />
                                                <TextBlock Style="{StaticResource SheetLabel}" Text="Current Hit Points" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SheetBox}">
                                            <StackPanel>
                                                <TextBox Style="{StaticResource SheetNumber}" FontSize="18" Text="{Binding Character.Combat.TemporaryHp}"
                                                         AutomationProperties.Name="Temporary hit points" />
                                                <TextBlock Style="{StaticResource SheetLabel}" Text="Temporary Hit Points" />
                                            </StackPanel>
                                        </Border>
                                        <UniformGrid Columns="2">
                                            <Border Style="{StaticResource SheetBox}">
                                                <StackPanel>
                                                    <TextBlock FontSize="9" Foreground="{StaticResource SheetFaint}">
                                                        <Run Text="Total" /> <Run Text="{Binding HitDiceTotal, Mode=OneWay}" /><Run Text="{Binding Character.Combat.HitDieSize, Mode=OneWay, StringFormat=d{0}}" />
                                                    </TextBlock>
                                                    <TextBox Style="{StaticResource SheetNumber}" FontSize="16" Text="{Binding Character.Combat.HitDiceRemaining}"
                                                             AutomationProperties.Name="Hit dice remaining" />
                                                    <TextBlock Style="{StaticResource SheetLabel}" Text="Hit Dice" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource SheetBox}">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                                        <TextBlock Text="Successes" FontSize="8.5" Width="48" VerticalAlignment="Center" />
                                                        <CheckBox Style="{StaticResource SheetDot}" IsHitTestVisible="False" Focusable="False" Margin="1,0"
                                                                  IsChecked="{Binding Character.Combat.DeathSaveSuccesses, Mode=OneWay, Converter={StaticResource AtLeast}, ConverterParameter=1}" />
                                                        <CheckBox Style="{StaticResource SheetDot}" IsHitTestVisible="False" Focusable="False" Margin="1,0"
                                                                  IsChecked="{Binding Character.Combat.DeathSaveSuccesses, Mode=OneWay, Converter={StaticResource AtLeast}, ConverterParameter=2}" />
                                                        <CheckBox Style="{StaticResource SheetDot}" IsHitTestVisible="False" Focusable="False" Margin="1,0"
                                                                  IsChecked="{Binding Character.Combat.DeathSaveSuccesses, Mode=OneWay, Converter={StaticResource AtLeast}, ConverterParameter=3}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                                        <TextBlock Text="Failures" FontSize="8.5" Width="48" VerticalAlignment="Center" />
                                                        <CheckBox Style="{StaticResource SheetDot}" IsHitTestVisible="False" Focusable="False" Margin="1,0"
                                                                  IsChecked="{Binding Character.Combat.DeathSaveFailures, Mode=OneWay, Converter={StaticResource AtLeast}, ConverterParameter=1}" />
                                                        <CheckBox Style="{StaticResource SheetDot}" IsHitTestVisible="False" Focusable="False" Margin="1,0"
                                                                  IsChecked="{Binding Character.Combat.DeathSaveFailures, Mode=OneWay, Converter={StaticResource AtLeast}, ConverterParameter=2}" />
                                                        <CheckBox Style="{StaticResource SheetDot}" IsHitTestVisible="False" Focusable="False" Margin="1,0"
                                                                  IsChecked="{Binding Character.Combat.DeathSaveFailures, Mode=OneWay, Converter={StaticResource AtLeast}, ConverterParameter=3}" />
                                                    </StackPanel>
                                                    <TextBlock Style="{StaticResource SheetLabel}" Text="{Binding VitalStatus, StringFormat=Death Saves {0}}" />
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource SheetBox}" MinHeight="170">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource SheetLabel}" Text="Attacks &amp; Spellcasting" />
                                        <Grid DockPanel.Dock="Top">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="18" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SheetLabelLeft}" Text="Name" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource SheetLabel}" Text="Atk Bonus" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource SheetLabelLeft}" Text="Damage/Type" Margin="4,0,0,0" />
                                            <Button Grid.Column="3" Style="{StaticResource SheetAddButton}" Command="{Binding AddAttack}" ToolTip="Add attack" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Attacks}" IsTabStop="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:AttackRow}">
                                                    <Grid Background="Transparent" Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="44" />
                                                            <ColumnDefinition Width="92" />
                                                            <ColumnDefinition Width="18" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Background="{StaticResource SheetShade}" CornerRadius="2" Margin="0,0,2,0">
                                                            <TextBox Style="{StaticResource SheetInput}" FontSize="11" Text="{Binding Model.Name}" AutomationProperties.Name="Attack name" />
                                                        </Border>
                                                        <Border Grid.Column="1" Background="{StaticResource SheetShade}" CornerRadius="2" Margin="0,0,2,0">
                                                            <TextBlock Text="{Binding AttackBonus, Converter={StaticResource Mod}}" HorizontalAlignment="Center" FontSize="11" VerticalAlignment="Center" />
                                                        </Border>
                                                        <Border Grid.Column="2" Background="{StaticResource SheetShade}" CornerRadius="2">
                                                            <TextBox Style="{StaticResource SheetInput}" FontSize="11" Text="{Binding Model.Damage}" AutomationProperties.Name="Damage" />
                                                        </Border>
                                                        <Button Grid.Column="3" Style="{StaticResource SheetRowButton}" Content="✕" ToolTip="Remove attack"
                                                                Command="{Binding DataContext.RemoveEntry, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </Border>

                                <Border Grid.Row="4" Style="{StaticResource SheetBox}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource SheetLabel}" Text="{Binding CarriedWeightText, StringFormat=Equipment  ·  {0}}" />
                                        <StackPanel DockPanel.Dock="Left" Width="54" Margin="0,0,6,0">
                                            <StackPanel.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{StaticResource SheetLine}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="CornerRadius" Value="8" />
                                                    <Setter Property="Margin" Value="0,2" />
                                                    <Setter Property="Padding" Value="2,1" />
                                                </Style>
                                            </StackPanel.Resources>
                                            <Border><StackPanel><TextBlock Style="{StaticResource SheetLabel}" Text="CP" /><TextBox Style="{StaticResource SheetNumber}" FontSize="11" Text="{Binding Character.Currency.Copper}" AutomationProperties.Name="Copper pieces" /></StackPanel></Border>
                                            <Border><StackPanel><TextBlock Style="{StaticResource SheetLabel}" Text="SP" /><TextBox Style="{StaticResource SheetNumber}" FontSize="11" Text="{Binding Character.Currency.Silver}" AutomationProperties.Name="Silver pieces" /></StackPanel></Border>
                                            <Border><StackPanel><TextBlock Style="{StaticResource SheetLabel}" Text="EP" /><TextBox Style="{StaticResource SheetNumber}" FontSize="11" Text="{Binding Character.Currency.Electrum}" AutomationProperties.Name="Electrum pieces" /></StackPanel></Border>
                                            <Border><StackPanel><TextBlock Style="{StaticResource SheetLabel}" Text="GP" /><TextBox Style="{StaticResource SheetNumber}" FontSize="11" Text="{Binding Character.Currency.Gold}" AutomationProperties.Name="Gold pieces" /></StackPanel></Border>
                                            <Border><StackPanel><TextBlock Style="{StaticResource SheetLabel}" Text="PP" /><TextBox Style="{StaticResource SheetNumber}" FontSize="11" Text="{Binding Character.Currency.Platinum}" AutomationProperties.Name="Platinum pieces" /></StackPanel></Border>
                                        </StackPanel>
                                        <Button DockPanel.Dock="Top" Style="{StaticResource SheetAddButton}" Command="{Binding AddItem}" ToolTip="Add item" />
                                        <ItemsControl ItemsSource="{Binding Character.Items}" IsTabStop="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type domain:Item}">
                                                    <Grid Background="Transparent">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="28" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="18" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Style="{StaticResource SheetNumber}" FontSize="11" Text="{Binding Quantity}" AutomationProperties.Name="Quantity" />
                                                        <TextBox Grid.Column="1" Style="{StaticResource SheetInput}" FontSize="11" Text="{Binding Name}" AutomationProperties.Name="Item name" />
                                                        <Button Grid.Column="2" Style="{StaticResource SheetRowButton}" Content="✕" ToolTip="Remove item"
                                                                Command="{Binding DataContext.RemoveEntry, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <!-- Column 3: personality and features -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource SheetShadedBox}">
                                    <StackPanel>
                                        <Border Style="{StaticResource SheetBox}">
                                            <StackPanel>
                                                <TextBox Style="{StaticResource SheetArea}" Height="64" Text="{Binding Character.Biography.PersonalityTraits}" AutomationProperties.Name="Personality traits" />
                                                <TextBlock Style="{StaticResource SheetLabel}" Text="Personality Traits" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SheetBox}">
                                            <StackPanel>
                                                <TextBox Style="{StaticResource SheetArea}" Height="48" Text="{Binding Character.Biography.Ideals}" AutomationProperties.Name="Ideals" />
                                                <TextBlock Style="{StaticResource SheetLabel}" Text="Ideals" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SheetBox}">
                                            <StackPanel>
                                                <TextBox Style="{StaticResource SheetArea}" Height="48" Text="{Binding Character.Biography.Bonds}" AutomationProperties.Name="Bonds" />
                                                <TextBlock Style="{StaticResource SheetLabel}" Text="Bonds" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SheetBox}">
                                            <StackPanel>
                                                <TextBox Style="{StaticResource SheetArea}" Height="48" Text="{Binding Character.Biography.Flaws}" AutomationProperties.Name="Flaws" />
                                                <TextBlock Style="{StaticResource SheetLabel}" Text="Flaws" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource SheetBox}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource SheetLabel}" Text="Features &amp; Traits" />
                                        <Button DockPanel.Dock="Top" Style="{StaticResource SheetAddButton}" Command="{Binding AddFeature}" ToolTip="Add feature or trait" />
                                        <ItemsControl ItemsSource="{Binding Character.Features}" IsTabStop="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type domain:Feature}">
                                                    <Grid Background="Transparent" Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="18" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBox Style="{StaticResource SheetInput}" FontSize="11" FontWeight="Bold" Text="{Binding Name}" AutomationProperties.Name="Feature name" />
                                                            <TextBox Style="{StaticResource SheetArea}" FontSize="10" Text="{Binding Description}" AutomationProperties.Name="Feature description" />
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource SheetRowButton}" Content="✕" ToolTip="Remove feature" VerticalAlignment="Top"
                                                                Command="{Binding DataContext.RemoveEntry, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ═════════════ PAGE 2 — BACKSTORY ═════════════ -->
                <Border x:Name="Page2" Style="{StaticResource SheetPage}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SheetShadedBox}" VerticalAlignment="Center" Padding="10,8">
                                <StackPanel>
                                    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <Border Height="1" Background="{StaticResource SheetLine}" />
                                    <TextBlock Style="{StaticResource SheetLabelLeft}" Text="Character Name" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SheetBox}">
                                <UniformGrid Columns="3" Rows="2">
                                    <HeaderedContentControl Header="Age" Style="{StaticResource SheetField}"><TextBox Style="{StaticResource SheetInput}" Text="{Binding Character.Biography.Age}" AutomationProperties.Name="Age" /></HeaderedContentControl>
                                    <HeaderedContentControl Header="Height" Style="{StaticResource SheetField}"><TextBox Style="{StaticResource SheetInput}" Text="{Binding Character.Biography.Height}" AutomationProperties.Name="Height" /></HeaderedContentControl>
                                    <HeaderedContentControl Header="Weight" Style="{StaticResource SheetField}"><TextBox Style="{StaticResource SheetInput}" Text="{Binding Character.Biography.Weight}" AutomationProperties.Name="Weight" /></HeaderedContentControl>
                                    <HeaderedContentControl Header="Eyes" Style="{StaticResource SheetField}"><TextBox Style="{StaticResource SheetInput}" Text="{Binding Character.Biography.Eyes}" AutomationProperties.Name="Eyes" /></HeaderedContentControl>
                                    <HeaderedContentControl Header="Skin" Style="{StaticResource SheetField}"><TextBox Style="{StaticResource SheetInput}" Text="{Binding Character.Biography.Skin}" AutomationProperties.Name="Skin" /></HeaderedContentControl>
                                    <HeaderedContentControl Header="Hair" Style="{StaticResource SheetField}"><TextBox Style="{StaticResource SheetInput}" Text="{Binding Character.Biography.Hair}" AutomationProperties.Name="Hair" /></HeaderedContentControl>
                                </UniformGrid>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource SheetBox}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource SheetLabel}" Text="Character Appearance" />
                                    <TextBox Style="{StaticResource SheetArea}" Text="{Binding Character.Biography.Appearance}" AutomationProperties.Name="Appearance" />
                                </DockPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SheetBox}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource SheetLabel}" Text="Allies &amp; Organizations" />
                                    <TextBox Style="{StaticResource SheetArea}" Text="{Binding Character.Biography.Allies}" AutomationProperties.Name="Allies and organizations" />
                                </DockPanel>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource SheetBox}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource SheetLabel}" Text="Character Backstory" />
                                    <TextBox Style="{StaticResource SheetArea}" Text="{Binding Character.Biography.Backstory}" AutomationProperties.Name="Backstory" />
                                </DockPanel>
                            </Border>
                            <Grid Grid.Row="1" Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource SheetBox}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource SheetLabel}" Text="Notes" />
                                        <TextBox Style="{StaticResource SheetArea}" Text="{Binding Character.Biography.Notes}" AutomationProperties.Name="Notes" />
                                    </DockPanel>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource SheetBox}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource SheetLabel}" Text="Treasure" />
                                        <TextBox Style="{StaticResource SheetArea}" Text="{Binding Character.Biography.Treasure}" AutomationProperties.Name="Treasure" />
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ═════════════ PAGE 3 — SPELLS ═════════════ -->
                <Border x:Name="Page3" Style="{StaticResource SheetPage}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource SheetShadedBox}" VerticalAlignment="Center" Padding="10,8">
                                <StackPanel>
                                    <TextBox Style="{StaticResource SheetInput}" FontSize="18" FontWeight="SemiBold"
                                             Text="{Binding Character.Spellcasting.SpellcastingClass}" AutomationProperties.Name="Spellcasting class" />
                                    <Border Height="1" Background="{StaticResource SheetLine}" />
                                    <TextBlock Style="{StaticResource SheetLabelLeft}" Text="Spellcasting Class" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SheetBox}">
                                <UniformGrid Columns="4">
                                    <HeaderedContentControl Header="Spellcasting Ability" Style="{StaticResource SheetField}">
                                        <ComboBox ItemsSource="{x:Static mvvm:Lookups.OptionalAbilities}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Character.Spellcasting.Ability}" BorderThickness="0" Background="Transparent"
                                                  AutomationProperties.Name="Spellcasting ability" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Spell Save DC" Style="{StaticResource SheetField}">
                                        <TextBlock Text="{Binding SpellSaveDc}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Spell Attack Bonus" Style="{StaticResource SheetField}">
                                        <TextBlock Text="{Binding SpellAttackBonus}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    </HeaderedContentControl>
                                    <HeaderedContentControl Header="Concentrating On" Style="{StaticResource SheetField}">
                                        <TextBox Style="{StaticResource SheetInput}" Text="{Binding Character.Spellcasting.Concentration}" AutomationProperties.Name="Concentrating on" />
                                    </HeaderedContentControl>
                                </UniformGrid>
                            </Border>
                        </Grid>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <ContentControl Content="{Binding SpellLevels[0]}" ContentTemplate="{StaticResource SpellLevelBlock}" IsTabStop="False" />
                                <ContentControl Content="{Binding SpellLevels[1]}" ContentTemplate="{StaticResource SpellLevelBlock}" IsTabStop="False" />
                                <ContentControl Content="{Binding SpellLevels[2]}" ContentTemplate="{StaticResource SpellLevelBlock}" IsTabStop="False" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <ContentControl Content="{Binding SpellLevels[3]}" ContentTemplate="{StaticResource SpellLevelBlock}" IsTabStop="False" />
                                <ContentControl Content="{Binding SpellLevels[4]}" ContentTemplate="{StaticResource SpellLevelBlock}" IsTabStop="False" />
                                <ContentControl Content="{Binding SpellLevels[5]}" ContentTemplate="{StaticResource SpellLevelBlock}" IsTabStop="False" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <ContentControl Content="{Binding SpellLevels[6]}" ContentTemplate="{StaticResource SpellLevelBlock}" IsTabStop="False" />
                                <ContentControl Content="{Binding SpellLevels[7]}" ContentTemplate="{StaticResource SpellLevelBlock}" IsTabStop="False" />
                                <ContentControl Content="{Binding SpellLevels[8]}" ContentTemplate="{StaticResource SpellLevelBlock}" IsTabStop="False" />
                                <ContentControl Content="{Binding SpellLevels[9]}" ContentTemplate="{StaticResource SpellLevelBlock}" IsTabStop="False" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
