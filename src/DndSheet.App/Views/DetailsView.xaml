<UserControl x:Class="DndSheet.App.Views.DetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DndSheet.App.ViewModels"
             xmlns:mvvm="clr-namespace:DndSheet.App.Mvvm"
             xmlns:domain="clr-namespace:DndSheet.Core.Domain;assembly=DndSheet.Core">
    <!-- Categorized editor over the same CharacterViewModel as the sheet and dashboard. -->
    <UserControl.Resources>
        <Style x:Key="Page" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Padding" Value="24,18" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="Num" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="70" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Wide" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Width" Value="240" />
        </Style>
        <Style x:Key="Toolbar" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <DataTemplate x:Key="RemoveCell">
            <Button Style="{StaticResource IconButton}" Content="✕" ToolTip="Remove"
                    Command="{Binding DataContext.RemoveEntry, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" AutomationProperties.Name="Remove" />
        </DataTemplate>
        <!-- Modifier editor used by items and effects. DataContext = Item or Effect. -->
        <DataTemplate x:Key="ModifierEditor">
            <StackPanel>
                <DockPanel Margin="0,4,0,4">
                    <Button DockPanel.Dock="Right" Content="+ Add modifier"
                            Command="{Binding DataContext.AddModifier, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" />
                    <TextBlock Text="Modifiers (applied while active)" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <DataGrid ItemsSource="{Binding Modifiers}" MaxHeight="180">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Target" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox IsEditable="True" ItemsSource="{x:Static mvvm:Lookups.StatTargetKeys}" BorderThickness="0"
                                              Text="{Binding Target, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Modifier target" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridComboBoxColumn Header="Kind" Width="90" ItemsSource="{x:Static mvvm:Lookups.ModifierKinds}" SelectedItemBinding="{Binding Kind}" />
                        <DataGridTextColumn Header="Value" Width="70" Binding="{Binding Value}" />
                        <DataGridTemplateColumn Width="36" CellTemplate="{StaticResource RemoveCell}" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <TabControl TabStripPlacement="Left" Background="{StaticResource Canvas}" BorderThickness="0" Padding="0">
        <TabControl.Resources>
            <Style TargetType="TabItem" BasedOn="{StaticResource NavTab}" />
        </TabControl.Resources>
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <DockPanel>
                    <Border DockPanel.Dock="Left" Background="{StaticResource Sidebar}" Width="190" Padding="0,10">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                </DockPanel>
            </ControlTemplate>
        </TabControl.Template>

        <!-- Identity -->
        <TabItem Header="Identity">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Identity" />
                    <TextBlock Style="{StaticResource Hint}" Text="Who the character is. Class defaults can pre-fill hit die, saves, HP and spell slots for built-in classes." />
                    <WrapPanel>
                        <HeaderedContentControl Header="Character name" Style="{StaticResource Field}">
                            <TextBox Style="{StaticResource Wide}" Text="{Binding Character.Identity.Name}" AutomationProperties.Name="Character name" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Player name" Style="{StaticResource Field}">
                            <TextBox Style="{StaticResource Wide}" Text="{Binding Character.Identity.PlayerName}" AutomationProperties.Name="Player name" />
                        </HeaderedContentControl>
                    </WrapPanel>
                    <WrapPanel>
                        <HeaderedContentControl Header="Class" Style="{StaticResource Field}">
                            <ComboBox Width="180" IsEditable="True" ItemsSource="{x:Static mvvm:Lookups.ClassNames}"
                                      Text="{Binding Character.Identity.ClassName, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Class" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Subclass" Style="{StaticResource Field}">
                            <TextBox Width="180" Text="{Binding Character.Identity.Subclass}" AutomationProperties.Name="Subclass" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Level (1–20)" Style="{StaticResource Field}">
                            <TextBox Style="{StaticResource Num}" Text="{Binding Character.Identity.Level}" AutomationProperties.Name="Level" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header=" " Style="{StaticResource Field}">
                            <Button Content="Apply class defaults…" Command="{Binding ApplyClassDefaults}" />
                        </HeaderedContentControl>
                    </WrapPanel>
                    <WrapPanel>
                        <HeaderedContentControl Header="Species" Style="{StaticResource Field}">
                            <ComboBox Width="180" IsEditable="True" ItemsSource="{x:Static mvvm:Lookups.Species}"
                                      Text="{Binding Character.Identity.Species, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Species" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Background" Style="{StaticResource Field}">
                            <TextBox Width="180" Text="{Binding Character.Identity.Background}" AutomationProperties.Name="Background" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Alignment" Style="{StaticResource Field}">
                            <ComboBox Width="180" IsEditable="True" ItemsSource="{x:Static mvvm:Lookups.Alignments}"
                                      Text="{Binding Character.Identity.Alignment, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Alignment" />
                        </HeaderedContentControl>
                    </WrapPanel>
                    <WrapPanel>
                        <HeaderedContentControl Header="Experience points" Style="{StaticResource Field}">
                            <TextBox Width="120" Text="{Binding Character.Identity.Experience}" AutomationProperties.Name="Experience points" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Inspiration" Style="{StaticResource Field}">
                            <CheckBox Content="Has inspiration" IsChecked="{Binding Character.Identity.Inspiration}" Margin="0,5,0,0" />
                        </HeaderedContentControl>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Abilities & saves -->
        <TabItem Header="Ability Scores &amp; Saves">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Ability Scores &amp; Saving Throws" />
                    <TextBlock Style="{StaticResource Hint}" Text="Enter base scores (1–30). Modifiers are calculated; items and effects can raise or set scores." />
                    <Grid Margin="0,0,0,6" TextElement.FontWeight="SemiBold" TextElement.Foreground="{StaticResource InkMuted}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130" /><ColumnDefinition Width="90" /><ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" /><ColumnDefinition Width="110" /><ColumnDefinition Width="90" /><ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ability" /><TextBlock Grid.Column="1" Text="Base score" /><TextBlock Grid.Column="2" Text="Effective" />
                        <TextBlock Grid.Column="3" Text="Modifier" /><TextBlock Grid.Column="4" Text="Save proficient" />
                        <TextBlock Grid.Column="5" Text="Save bonus" /><TextBlock Grid.Column="6" Text="Save total" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Abilities}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AbilityRow}">
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" /><ColumnDefinition Width="90" /><ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" /><ColumnDefinition Width="110" /><ColumnDefinition Width="90" /><ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBox Grid.Column="1" Style="{StaticResource Num}" Text="{Binding Score}" AutomationProperties.Name="{Binding Name, StringFormat={}{0} base score}" />
                                    <TextBlock Grid.Column="2" Text="{Binding EffectiveScore}" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding Modifier, Converter={StaticResource Mod}}" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Margin="8,0" />
                                    <CheckBox Grid.Column="4" IsChecked="{Binding Save.Proficient}" AutomationProperties.Name="{Binding Name, StringFormat={}{0} save proficient}" />
                                    <TextBox Grid.Column="5" Style="{StaticResource Num}" Text="{Binding Save.Bonus}" AutomationProperties.Name="{Binding Name, StringFormat={}{0} save bonus}" />
                                    <TextBlock Grid.Column="6" Text="{Binding SaveModifier, Converter={StaticResource Mod}}" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Margin="8,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,18,0,0" Foreground="{StaticResource InkMuted}">
                        <Run Text="Proficiency bonus" /> <Run Text="{Binding ProficiencyBonus, Mode=OneWay, Converter={StaticResource Mod}}" FontWeight="SemiBold" />
                        <Run Text="  (from level)" />
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Skills -->
        <TabItem Header="Skills">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Skills" />
                    <TextBlock Style="{StaticResource Hint}" Text="Half proficiency covers features like Jack of All Trades. Expertise doubles the proficiency bonus." />
                    <ItemsControl ItemsSource="{Binding Skills}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SkillRow}">
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" /><ColumnDefinition Width="50" /><ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="90" /><ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{Binding AbilityAbbreviation}" VerticalAlignment="Center" Foreground="{StaticResource InkMuted}" />
                                    <ComboBox Grid.Column="2" Margin="0,0,10,0" ItemsSource="{x:Static mvvm:Lookups.ProficiencyLevels}" SelectedItem="{Binding Model.Proficiency}"
                                              AutomationProperties.Name="{Binding Name, StringFormat={}{0} proficiency}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" /></DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox Grid.Column="3" Style="{StaticResource Num}" Text="{Binding Model.Bonus}" ToolTip="Extra bonus"
                                             AutomationProperties.Name="{Binding Name, StringFormat={}{0} bonus}" />
                                    <TextBlock Grid.Column="4" Text="{Binding Modifier, Converter={StaticResource Mod}}" VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Combat -->
        <TabItem Header="Combat">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Combat" />
                    <TextBlock Style="{StaticResource Hint}">
                        <Run Text="Effective values after items and effects: AC" /> <Run Text="{Binding ArmorClass, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" · Initiative" /> <Run Text="{Binding Initiative, Mode=OneWay, Converter={StaticResource Mod}}" FontWeight="SemiBold" />
                        <Run Text=" · Speed" /> <Run Text="{Binding Speed, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" · Max HP" /> <Run Text="{Binding MaxHitPoints, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" · Passive Perception" /> <Run Text="{Binding PassivePerception, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <WrapPanel>
                        <HeaderedContentControl Header="Base armor class" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Combat.ArmorClass}" AutomationProperties.Name="Base armor class" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Initiative bonus" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Combat.InitiativeBonus}" AutomationProperties.Name="Initiative bonus" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Base speed (ft)" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Combat.Speed}" AutomationProperties.Name="Base speed" /></HeaderedContentControl>
                    </WrapPanel>
                    <WrapPanel>
                        <HeaderedContentControl Header="Base max HP" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Combat.MaxHp}" AutomationProperties.Name="Base maximum hit points" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Current HP" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Combat.CurrentHp}" AutomationProperties.Name="Current hit points" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Temporary HP" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Combat.TemporaryHp}" AutomationProperties.Name="Temporary hit points" /></HeaderedContentControl>
                    </WrapPanel>
                    <WrapPanel>
                        <HeaderedContentControl Header="Hit die" Style="{StaticResource Field}">
                            <ComboBox Width="80" ItemsSource="{x:Static mvvm:Lookups.HitDieSizes}" SelectedItem="{Binding Character.Combat.HitDieSize}"
                                      ItemStringFormat="d{0}" AutomationProperties.Name="Hit die size" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Hit dice remaining" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Combat.HitDiceRemaining}" AutomationProperties.Name="Hit dice remaining" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Death save successes" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Combat.DeathSaveSuccesses}" AutomationProperties.Name="Death save successes" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Death save failures" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Combat.DeathSaveFailures}" AutomationProperties.Name="Death save failures" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Stable" Style="{StaticResource Field}"><CheckBox Content="Stable at 0 HP" IsChecked="{Binding Character.Combat.IsStable}" Margin="0,5,0,0" /></HeaderedContentControl>
                    </WrapPanel>

                    <DockPanel Margin="0,14,0,6">
                        <Button DockPanel.Dock="Right" Content="+ Add attack" Command="{Binding AddAttack}" />
                        <TextBlock Text="Attacks" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding Attacks}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Model.Name}" />
                            <DataGridComboBoxColumn Header="Ability" Width="120" ItemsSource="{x:Static mvvm:Lookups.OptionalAbilities}"
                                                    DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValueBinding="{Binding Model.Ability}" />
                            <DataGridCheckBoxColumn Header="Proficient" Width="80" Binding="{Binding Model.Proficient, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTextColumn Header="Extra bonus" Width="90" Binding="{Binding Model.Bonus}" />
                            <DataGridTextColumn Header="To hit" Width="70" IsReadOnly="True" Binding="{Binding AttackBonus, Converter={StaticResource Mod}}" />
                            <DataGridTextColumn Header="Damage / type" Width="150" Binding="{Binding Model.Damage}" />
                            <DataGridTextColumn Header="Notes" Width="*" Binding="{Binding Model.Notes}" />
                            <DataGridTemplateColumn Width="36" CellTemplate="{StaticResource RemoveCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Proficiencies -->
        <TabItem Header="Proficiencies">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Proficiencies &amp; Languages" />
                    <TextBlock Style="{StaticResource Hint}" Text="Armor, weapon and tool proficiencies and known languages. Skill and saving throw proficiencies are set on their own pages." />
                    <StackPanel Style="{StaticResource Toolbar}">
                        <Button Content="+ Armor" Command="{Binding AddProficiency}" CommandParameter="{x:Static domain:ProficiencyCategory.Armor}" />
                        <Button Content="+ Weapon" Command="{Binding AddProficiency}" CommandParameter="{x:Static domain:ProficiencyCategory.Weapon}" />
                        <Button Content="+ Tool" Command="{Binding AddProficiency}" CommandParameter="{x:Static domain:ProficiencyCategory.Tool}" />
                        <Button Content="+ Language" Command="{Binding AddProficiency}" CommandParameter="{x:Static domain:ProficiencyCategory.Language}" />
                        <Button Content="+ Other" Command="{Binding AddProficiency}" CommandParameter="{x:Static domain:ProficiencyCategory.Other}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Character.Proficiencies}" MaxHeight="600">
                        <DataGrid.Columns>
                            <DataGridComboBoxColumn Header="Category" Width="140" ItemsSource="{x:Static mvvm:Lookups.ProficiencyCategories}" SelectedItemBinding="{Binding Category}" />
                            <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}" />
                            <DataGridTemplateColumn Width="36" CellTemplate="{StaticResource RemoveCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Features -->
        <TabItem Header="Features &amp; Traits">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Features &amp; Traits" />
                    <TextBlock Style="{StaticResource Hint}" Text="Class, subclass, species and background features, feats, traits and anything custom. Select a row to edit its description." />
                    <StackPanel Style="{StaticResource Toolbar}">
                        <Button Content="+ Add feature" Command="{Binding AddFeature}" />
                    </StackPanel>
                    <DataGrid x:Name="FeatureGrid" ItemsSource="{Binding Character.Features}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}" />
                            <DataGridComboBoxColumn Header="Source" Width="140" ItemsSource="{x:Static mvvm:Lookups.FeatureSources}" SelectedItemBinding="{Binding Source}" />
                            <DataGridTemplateColumn Width="36" CellTemplate="{StaticResource RemoveCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <HeaderedContentControl Header="Description" Style="{StaticResource Field}"
                                            Visibility="{Binding SelectedItem, ElementName=FeatureGrid, Converter={StaticResource VisibleWhen}}">
                        <TextBox Style="{StaticResource MultilineBox}" MinHeight="140" Text="{Binding SelectedItem.Description, ElementName=FeatureGrid}"
                                 AutomationProperties.Name="Feature description" />
                    </HeaderedContentControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Equipment -->
        <TabItem Header="Equipment">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Equipment" />
                    <TextBlock Style="{StaticResource Hint}">
                        <Run Text="Carrying" /> <Run Text="{Binding CarriedWeightText, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=". Equipped items (attuned, if they require it) apply their modifiers." />
                    </TextBlock>
                    <WrapPanel>
                        <HeaderedContentControl Header="Copper" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Currency.Copper}" AutomationProperties.Name="Copper" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Silver" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Currency.Silver}" AutomationProperties.Name="Silver" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Electrum" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Currency.Electrum}" AutomationProperties.Name="Electrum" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Gold" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Currency.Gold}" AutomationProperties.Name="Gold" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Platinum" Style="{StaticResource Field}"><TextBox Style="{StaticResource Num}" Text="{Binding Character.Currency.Platinum}" AutomationProperties.Name="Platinum" /></HeaderedContentControl>
                    </WrapPanel>
                    <StackPanel Style="{StaticResource Toolbar}">
                        <Button Content="+ Add item" Command="{Binding AddItem}" />
                    </StackPanel>
                    <DataGrid x:Name="ItemGrid" ItemsSource="{Binding Character.Items}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Qty" Width="60" Binding="{Binding Quantity}" />
                            <DataGridTextColumn Header="Weight (lb)" Width="90" Binding="{Binding Weight}" />
                            <DataGridCheckBoxColumn Header="Equipped" Width="80" Binding="{Binding Equipped, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridCheckBoxColumn Header="Needs attunement" Width="130" Binding="{Binding RequiresAttunement, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridCheckBoxColumn Header="Attuned" Width="70" Binding="{Binding Attuned, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTemplateColumn Width="36" CellTemplate="{StaticResource RemoveCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Visibility="{Binding SelectedItem, ElementName=ItemGrid, Converter={StaticResource VisibleWhen}}">
                        <HeaderedContentControl Header="Description / notes" Style="{StaticResource Field}">
                            <TextBox Style="{StaticResource MultilineBox}" Text="{Binding SelectedItem.Description, ElementName=ItemGrid}" AutomationProperties.Name="Item description" />
                        </HeaderedContentControl>
                        <ContentControl Content="{Binding SelectedItem, ElementName=ItemGrid}" ContentTemplate="{StaticResource ModifierEditor}" IsTabStop="False" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Spells -->
        <TabItem Header="Spells">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Spellcasting" />
                    <TextBlock Style="{StaticResource Hint}">
                        <Run Text="Spell save DC" /> <Run Text="{Binding SpellSaveDc, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=" · Spell attack" /> <Run Text="{Binding SpellAttackBonus, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text=". Spell text is yours to enter — no rulebook text is bundled." />
                    </TextBlock>
                    <WrapPanel>
                        <HeaderedContentControl Header="Spellcasting ability" Style="{StaticResource Field}">
                            <ComboBox Width="160" ItemsSource="{x:Static mvvm:Lookups.OptionalAbilities}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Character.Spellcasting.Ability}" AutomationProperties.Name="Spellcasting ability" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Spellcasting class" Style="{StaticResource Field}">
                            <TextBox Width="180" Text="{Binding Character.Spellcasting.SpellcastingClass}" AutomationProperties.Name="Spellcasting class" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="Concentrating on" Style="{StaticResource Field}">
                            <TextBox Width="180" Text="{Binding Character.Spellcasting.Concentration}" AutomationProperties.Name="Concentrating on" />
                        </HeaderedContentControl>
                    </WrapPanel>
                    <TextBlock Text="Spell slots" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,6" />
                    <ItemsControl ItemsSource="{Binding Character.Spellcasting.Slots}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type domain:SpellSlotLevel}">
                                <Border Style="{StaticResource Card}" Padding="10,6" Margin="0,0,8,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Level, StringFormat=Level {0}}" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Max" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{StaticResource InkMuted}" />
                                            <TextBox Width="36" HorizontalContentAlignment="Center" Text="{Binding Maximum}" AutomationProperties.Name="{Binding Level, StringFormat=Level {0} slots maximum}" />
                                            <TextBlock Text="Used" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{StaticResource InkMuted}" />
                                            <TextBox Width="36" HorizontalContentAlignment="Center" Text="{Binding Expended}" AutomationProperties.Name="{Binding Level, StringFormat=Level {0} slots used}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,8,0,6">
                        <Button DockPanel.Dock="Right" Content="+ Add spell" Command="{Binding AddSpell}" CommandParameter="{Binding SelectedItem.Level, ElementName=SpellGrid}" />
                        <TextBlock Text="Spells" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid x:Name="SpellGrid" ItemsSource="{Binding Character.Spellcasting.Spells}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Prep." Width="50" Binding="{Binding Prepared, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridComboBoxColumn Header="Lvl" Width="55" ItemsSource="{x:Static mvvm:Lookups.SpellLevels}" SelectedItemBinding="{Binding Level}" />
                            <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}" />
                            <DataGridTemplateColumn Header="School" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox IsEditable="True" BorderThickness="0" ItemsSource="{x:Static mvvm:Lookups.SpellSchools}"
                                                  Text="{Binding School, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="School" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Casting time" Width="95" Binding="{Binding CastingTime}" />
                            <DataGridTextColumn Header="Range" Width="80" Binding="{Binding Range}" />
                            <DataGridTextColumn Header="Components" Width="90" Binding="{Binding Components}" />
                            <DataGridTextColumn Header="Duration" Width="95" Binding="{Binding Duration}" />
                            <DataGridCheckBoxColumn Header="Conc." Width="50" Binding="{Binding Concentration, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridCheckBoxColumn Header="Ritual" Width="50" Binding="{Binding Ritual, UpdateSourceTrigger=PropertyChanged}" />
                            <DataGridTemplateColumn Width="36" CellTemplate="{StaticResource RemoveCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Visibility="{Binding SelectedItem, ElementName=SpellGrid, Converter={StaticResource VisibleWhen}}">
                        <HeaderedContentControl Header="Description" Style="{StaticResource Field}">
                            <TextBox Style="{StaticResource MultilineBox}" MinHeight="110" Text="{Binding SelectedItem.Description, ElementName=SpellGrid}" AutomationProperties.Name="Spell description" />
                        </HeaderedContentControl>
                        <HeaderedContentControl Header="At higher levels" Style="{StaticResource Field}">
                            <TextBox Style="{StaticResource MultilineBox}" Text="{Binding SelectedItem.HigherLevels, ElementName=SpellGrid}" AutomationProperties.Name="Higher level casting" />
                        </HeaderedContentControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Resources -->
        <TabItem Header="Resources">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Resources" />
                    <TextBlock Style="{StaticResource Hint}" Text="Limited-use abilities and counters. 'Recovers' decides what rests refill; leave 'Amount' empty to refill completely. Manual resources are flagged after rests for you to adjust." />
                    <StackPanel Style="{StaticResource Toolbar}">
                        <Button Content="+ Add resource" Command="{Binding AddResource}" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Character.Resources}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Current" Width="70" Binding="{Binding Current}" />
                            <DataGridTextColumn Header="Maximum" Width="75" Binding="{Binding Maximum}" />
                            <DataGridComboBoxColumn Header="Recovers" Width="150" ItemsSource="{x:Static mvvm:Lookups.RecoveryTimings}" SelectedItemBinding="{Binding Recovery}" />
                            <DataGridTextColumn Header="Amount" Width="70" Binding="{Binding RecoveryAmount, TargetNullValue=''}" />
                            <DataGridTextColumn Header="Notes" Width="*" Binding="{Binding Notes}" />
                            <DataGridTemplateColumn Width="36" CellTemplate="{StaticResource RemoveCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Conditions & effects -->
        <TabItem Header="Conditions &amp; Effects">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Conditions &amp; Effects" />
                    <TextBlock Style="{StaticResource Hint}" Text="Conditions are tracked for reference. Effects (Bless, potions, curses…) can carry modifiers and expire automatically on rests." />
                    <ItemsControl ItemsSource="{Binding Conditions}" IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ConditionToggle}">
                                <ToggleButton Style="{StaticResource PillToggle}" Content="{Binding Name}" IsChecked="{Binding IsActive}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <HeaderedContentControl Header="Exhaustion level (0–6)" Style="{StaticResource Field}" Margin="0,8,0,12">
                        <TextBox Style="{StaticResource Num}" Text="{Binding Character.ExhaustionLevel}" AutomationProperties.Name="Exhaustion level" />
                    </HeaderedContentControl>
                    <DockPanel Margin="0,4,0,6">
                        <Button DockPanel.Dock="Right" Content="+ Add effect" Command="{Binding AddEffect}" />
                        <TextBlock Text="Active effects" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid x:Name="EffectGrid" ItemsSource="{Binding Character.Effects}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Width="*" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Duration" Width="120" Binding="{Binding Duration}" />
                            <DataGridComboBoxColumn Header="Expires" Width="150" ItemsSource="{x:Static mvvm:Lookups.EffectExpiries}" SelectedItemBinding="{Binding Expiry}" />
                            <DataGridTemplateColumn Width="36" CellTemplate="{StaticResource RemoveCell}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Visibility="{Binding SelectedItem, ElementName=EffectGrid, Converter={StaticResource VisibleWhen}}">
                        <HeaderedContentControl Header="Description" Style="{StaticResource Field}">
                            <TextBox Style="{StaticResource MultilineBox}" Text="{Binding SelectedItem.Description, ElementName=EffectGrid}" AutomationProperties.Name="Effect description" />
                        </HeaderedContentControl>
                        <ContentControl Content="{Binding SelectedItem, ElementName=EffectGrid}" ContentTemplate="{StaticResource ModifierEditor}" IsTabStop="False" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Biography -->
        <TabItem Header="Biography &amp; Notes">
            <ScrollViewer Style="{StaticResource Page}">
                <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Biography &amp; Notes" />
                    <WrapPanel Margin="0,8,0,0">
                        <HeaderedContentControl Header="Age" Style="{StaticResource Field}"><TextBox Width="110" Text="{Binding Character.Biography.Age}" AutomationProperties.Name="Age" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Height" Style="{StaticResource Field}"><TextBox Width="110" Text="{Binding Character.Biography.Height}" AutomationProperties.Name="Height" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Weight" Style="{StaticResource Field}"><TextBox Width="110" Text="{Binding Character.Biography.Weight}" AutomationProperties.Name="Weight" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Eyes" Style="{StaticResource Field}"><TextBox Width="110" Text="{Binding Character.Biography.Eyes}" AutomationProperties.Name="Eyes" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Skin" Style="{StaticResource Field}"><TextBox Width="110" Text="{Binding Character.Biography.Skin}" AutomationProperties.Name="Skin" /></HeaderedContentControl>
                        <HeaderedContentControl Header="Hair" Style="{StaticResource Field}"><TextBox Width="110" Text="{Binding Character.Biography.Hair}" AutomationProperties.Name="Hair" /></HeaderedContentControl>
                    </WrapPanel>
                    <HeaderedContentControl Header="Personality traits" Style="{StaticResource Field}"><TextBox Style="{StaticResource MultilineBox}" Text="{Binding Character.Biography.PersonalityTraits}" AutomationProperties.Name="Personality traits" /></HeaderedContentControl>
                    <HeaderedContentControl Header="Ideals" Style="{StaticResource Field}"><TextBox Style="{StaticResource MultilineBox}" Text="{Binding Character.Biography.Ideals}" AutomationProperties.Name="Ideals" /></HeaderedContentControl>
                    <HeaderedContentControl Header="Bonds" Style="{StaticResource Field}"><TextBox Style="{StaticResource MultilineBox}" Text="{Binding Character.Biography.Bonds}" AutomationProperties.Name="Bonds" /></HeaderedContentControl>
                    <HeaderedContentControl Header="Flaws" Style="{StaticResource Field}"><TextBox Style="{StaticResource MultilineBox}" Text="{Binding Character.Biography.Flaws}" AutomationProperties.Name="Flaws" /></HeaderedContentControl>
                    <HeaderedContentControl Header="Appearance" Style="{StaticResource Field}"><TextBox Style="{StaticResource MultilineBox}" Text="{Binding Character.Biography.Appearance}" AutomationProperties.Name="Appearance" /></HeaderedContentControl>
                    <HeaderedContentControl Header="Backstory" Style="{StaticResource Field}"><TextBox Style="{StaticResource MultilineBox}" MinHeight="140" Text="{Binding Character.Biography.Backstory}" AutomationProperties.Name="Backstory" /></HeaderedContentControl>
                    <HeaderedContentControl Header="Allies &amp; organizations" Style="{StaticResource Field}"><TextBox Style="{StaticResource MultilineBox}" Text="{Binding Character.Biography.Allies}" AutomationProperties.Name="Allies" /></HeaderedContentControl>
                    <HeaderedContentControl Header="Treasure" Style="{StaticResource Field}"><TextBox Style="{StaticResource MultilineBox}" Text="{Binding Character.Biography.Treasure}" AutomationProperties.Name="Treasure" /></HeaderedContentControl>
                    <HeaderedContentControl Header="Notes" Style="{StaticResource Field}"><TextBox Style="{StaticResource MultilineBox}" MinHeight="140" Text="{Binding Character.Biography.Notes}" AutomationProperties.Name="Notes" /></HeaderedContentControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
