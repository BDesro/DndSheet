<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Printed-sheet look: black ink on white, rounded boxes, small-caps labels under values. -->
    <SolidColorBrush x:Key="SheetInk" Color="#111111" />
    <SolidColorBrush x:Key="SheetLine" Color="#2A2A2A" />
    <SolidColorBrush x:Key="SheetFaint" Color="#8C8C8C" />
    <SolidColorBrush x:Key="SheetShade" Color="#F1EFEA" />

    <Style x:Key="SheetPage" TargetType="Border">
        <Setter Property="Width" Value="816" />
        <Setter Property="MinHeight" Value="1056" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Padding" Value="28,26" />
        <Setter Property="Margin" Value="0,0,0,24" />
        <Setter Property="TextElement.Foreground" Value="{StaticResource SheetInk}" />
        <Setter Property="TextElement.FontFamily" Value="Segoe UI" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.18" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SheetBox" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource SheetLine}" />
        <Setter Property="BorderThickness" Value="1.4" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="Margin" Value="3" />
        <Setter Property="Background" Value="White" />
    </Style>

    <Style x:Key="SheetShadedBox" TargetType="Border" BasedOn="{StaticResource SheetBox}">
        <Setter Property="Background" Value="{StaticResource SheetShade}" />
    </Style>

    <Style x:Key="SheetLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="8.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource SheetInk}" />
        <Setter Property="Typography.Capitals" Value="AllSmallCaps" />
    </Style>

    <Style x:Key="SheetLabelLeft" TargetType="TextBlock" BasedOn="{StaticResource SheetLabel}">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="TextAlignment" Value="Left" />
    </Style>

    <Style x:Key="SheetBig" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Borderless in-place editor; underline appears on hover/focus so the page stays print-clean. -->
    <Style x:Key="SheetInput" TargetType="TextBox">
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource SheetInk}" />
        <Setter Property="Padding" Value="1,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource ErrorTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource SheetFaint}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="Background" Value="#FBF6F4" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SheetNumber" TargetType="TextBox" BasedOn="{StaticResource SheetInput}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="SheetArea" TargetType="TextBox" BasedOn="{StaticResource SheetInput}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Proficiency bubble: empty circle / filled circle. -->
    <Style x:Key="SheetDot" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="12" Height="12" Background="Transparent">
                        <Ellipse Stroke="{StaticResource SheetLine}" StrokeThickness="1.2" />
                        <Ellipse x:Name="Fill" Margin="2.5" Fill="{StaticResource SheetInk}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fill" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hover-only row buttons (hidden until the row is hovered or focused, so pages print clean). -->
    <Style x:Key="SheetRowButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Grid}}" Value="True">
                <Setter Property="Opacity" Value="1" />
            </DataTrigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SheetAddButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Content" Value="+" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
</ResourceDictionary>
